ACCOUNTANT_REPORT_TYPES = {
    "🌰 Закупки сырья (отчёт)": "raw",
    "📦 Расходники (отчёт)": "consumables",
    "💵 Зарплаты (отчёт)": "salary",
    "📉 Прочие расходы (отчёт)": "other",
    "💰 Оплаты поставщикам (отчёт)": "supplier_payments",
}

SUPPLIER_COUNTERPARTY_TYPES = ["поставщик сырья", "поставщик расходников"]


def _cp_name(row: dict) -> str:
    cp = row.get("counterparties")
    return (cp or {}).get("name") or "—"


def _fmt_date_ru(iso_date: str) -> str:
    return datetime.strptime(iso_date[:10], "%Y-%m-%d").strftime("%d.%m.%Y")


def _fmt_amount_ru(x: float) -> str:
    x = round(x, 2)
    s = f"{x:,.0f}" if x == int(x) else f"{x:,.2f}"
    return s.replace(",", " ")


def build_category_report_text(title: str, rows: list, qty_unit: str = "шт", use_comment_fallback: bool = True) -> str:
    if not rows:
        return f"{title}\n\nЗа период ничего не найдено."
    lines = [f"{title}\n"]
    total = 0.0
    for r in rows:
        amount = float(r["amount"])
        total += amount
        qty = r.get("quantity")
        qty_str = f"{float(qty):.0f} {qty_unit}" if qty is not None else "—"
        price = r.get("price")
        price_str = f"{float(price):.2f}₽/{qty_unit}" if price is not None else "—"
        item = r.get("item_name") or (r.get("comment") if use_comment_fallback else None) or "—"
        lines.append(f"▫️ {_fmt_date_ru(r['operation_date'])} | {item} | {qty_str} | {price_str} | {amount:.2f}₽ | {_cp_name(r)}")
    lines.append(f"\n💰 Итого: {round(total,2)}₽")
    return "\n".join(lines)


def build_other_expenses_report_text(rows: list) -> str:
    title = "📉 Прочие расходы склада"
    if not rows:
        return f"{title}\n\nЗа период ничего не найдено."
    lines = [f"{title}\n"]
    total = 0.0
    for r in rows:
        amount = float(r["amount"])
        total += amount
        cat_name = (r.get("categories") or {}).get("name") or "—"
        lines.append(f"▫️ {_fmt_date_ru(r['operation_date'])} | {cat_name} | {r.get('comment') or '—'} | {amount:.2f}₽ | {_cp_name(r)}")
    lines.append(f"\n💰 Итого: {round(total,2)}₽")
    return "\n".join(lines)


def build_supplier_payments_report_text(ledger_rows: list, date_from: str, date_to: str) -> str:
    title = "💰 Оплаты поставщикам"
    balances = {}
    payments = []
    for r in ledger_rows:
        cp_id = r["counterparty_id"]
        balances[cp_id] = balances.get(cp_id, 0.0) + float(r["amount"])
        op_date = r["operation_date"][:10]
        if r["operation_type"] == "оплата" and date_from <= op_date <= date_to:
            payments.append({
                "date": r["operation_date"],
                "amount": float(r["amount"]),
                "supplier": _cp_name(r),
                "balance_after": balances[cp_id],
            })
    if not payments:
        return f"{title}\n\nЗа период ничего не найдено."
    payments.sort(key=lambda p: p["date"])
    lines = [f"{title}\n"]
    total = 0.0
    for p in payments:
        total += p["amount"]
        lines.append(f"▫️ {_fmt_date_ru(p['date'])} | {_fmt_amount_ru(p['amount'])}₽ | {p['supplier']} | остаток: {_fmt_amount_ru(p['balance_after'])}₽")
    lines.append(f"\n💰 Итого выплачено: {_fmt_amount_ru(abs(total))}₽")
    return "\n".join(lines)


async def accountant_report_start(update, context):
    if context.bot_data["db"].get_dynamic_role(update.effective_user.id) != "accountant":
        return ConversationHandler.END
    t = update.message.text.strip()
    report_type = ACCOUNTANT_REPORT_TYPES.get(t)
    if not report_type:
        return ConversationHandler.END
    context.user_data["acc_report_type"] = report_type
    t_now = datetime.now(TZ_MSK)
    kb = [[f"Этот месяц (с {t_now.replace(day=1).strftime('%d.%m')})"], ["Свой период (ДД.ММ-ДД.ММ)"], ["❌ Главное меню"]]
    await update.message.reply_text(f"{t}\n\nЗа какой период?", reply_markup=ReplyKeyboardMarkup(kb, resize_keyboard=True))
    return ACC_REPORT_PERIOD


async def _run_accountant_report(update, context, date_from, date_to):
    db = context.bot_data["db"]
    report_type = context.user_data.get("acc_report_type")
    raw_cat_id = db.get_category_id("Закупка сырья (орехи/сухофрукты)")
    consumables_cat_id = db.get_category_id("Расходники (упаковка, скотч, этикетки)")

    if report_type == "raw":
        rows = db.get_category_report_rows(raw_cat_id, date_from, date_to, operation_types=["покупка"])
        text = build_category_report_text("🌰 Закупки сырья", rows, qty_unit="кг", use_comment_fallback=False)
    elif report_type == "consumables":
        rows = db.get_category_report_rows(consumables_cat_id, date_from, date_to, operation_types=["покупка"])
        text = build_category_report_text("📦 Расходники", rows, qty_unit="шт")
    elif report_type == "salary":
        cat_id = db.get_category_id("Зарплата")
        rows = db.get_category_report_rows(cat_id, date_from, date_to, operation_types=["начисление", "сторно"])
        text = build_category_report_text("💵 Зарплаты", rows, qty_unit="шт")
    elif report_type == "other":
        text = build_other_expenses_report_text(db.get_other_warehouse_expenses_rows([raw_cat_id, consumables_cat_id], date_from, date_to))
    elif report_type == "supplier_payments":
        supplier_ids = [s["id"] for t in SUPPLIER_COUNTERPARTY_TYPES for s in db.get_suppliers_list(type_filter=t)]
        text = build_supplier_payments_report_text(db.get_supplier_ledger_rows(supplier_ids), date_from, date_to)
    else:
        text = "⚠️ Не понял тип отчёта, начните заново."

    await update.message.reply_text(text, reply_markup=get_menu_keyboard(update.effective_user.id, db))


async def accountant_report_period(update, context):
    t = update.message.text.strip()
    if t == "❌ Главное меню": return await cancel_to_menu(update, context)
    t_now = datetime.now(TZ_MSK)

    if "Этот месяц" in t:
        date_from = t_now.replace(day=1).date().isoformat()
        date_to = t_now.date().isoformat()
        await _run_accountant_report(update, context, date_from, date_to)
        return ConversationHandler.END

    if "Свой период" in t:
        await update.message.reply_text("Введите период в формате ДД.ММ-ДД.ММ (например 01.07-31.07):", reply_markup=get_step_keyboard())
        return ACC_REPORT_PERIOD_CUSTOM

    kb = [[f"Этот месяц (с {t_now.replace(day=1).strftime('%d.%m')})"], ["Свой период (ДД.ММ-ДД.ММ)"], ["❌ Главное меню"]]
    await update.message.reply_text("⚠️ Не понял выбор. Нажмите один из вариантов на клавиатуре:", reply_markup=ReplyKeyboardMarkup(kb, resize_keyboard=True))
    return ACC_REPORT_PERIOD


async def accountant_report_period_custom(update, context):
    t = update.message.text.strip()
    if t == "❌ Главное меню": return await cancel_to_menu(update, context)
    try:
        start_raw, end_raw = t.split("-")
        date_from = parse_flexible_date(start_raw.strip(), TZ_MSK)[0]
        date_to = parse_flexible_date(end_raw.strip(), TZ_MSK)[0]
        if not date_from or not date_to:
            raise ValueError
    except Exception:
        await update.message.reply_text("⚠️ Не понял период. Формат: ДД.ММ-ДД.ММ, например 01.07-31.07. Попробуйте ещё раз:", reply_markup=get_step_keyboard())
        return ACC_REPORT_PERIOD_CUSTOM

    await _run_accountant_report(update, context, date_from, date_to)
    return ConversationHandler.END


