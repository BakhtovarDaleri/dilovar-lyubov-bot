async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    db = context.bot_data["db"]
    kb = get_menu_keyboard(uid, db)
    if kb:
        await update.message.reply_text(f"👋 Добро пожаловать!\n\n{RULES_TEXT}", reply_markup=kb, parse_mode="Markdown")
        return

    status = db.get_access_request_status(uid)
    if status == "pending":
        await update.message.reply_text("⏳ Заявка уже отправлена администратору, ждите подтверждения.")
        return
    if status == "rejected":
        await update.message.reply_text("🔒 Доступ был отклонён администратором. Если это ошибка — обратитесь к нему напрямую.")
        return

    u = update.effective_user
    name = f"{u.first_name or ''} {u.last_name or ''}".strip() or "Без имени"
    username = f"@{u.username}" if u.username else None
    db.create_access_request(uid, name, username)
    await update.message.reply_text("⏳ Заявка отправлена администратору, ждите подтверждения.")

    if ADMIN_NOTIFY_ID:
        kb_admin = InlineKeyboardMarkup([[
            InlineKeyboardButton("✅ Одобрить как бухгалтер", callback_data=f"db_appr_acc_{uid}"),
            InlineKeyboardButton("❌ Отклонить", callback_data=f"db_rej_{uid}"),
        ]])
        text = f"🔔 Новая заявка на доступ к боту:\n👤 {name}"
        if username:
            text += f" ({username})"
        text += f"\n🆔 ID: `{uid}`"
        await context.bot.send_message(chat_id=ADMIN_NOTIFY_ID, text=text, reply_markup=kb_admin, parse_mode="Markdown")


async def access_request_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    if update.effective_user.id != ADMIN_NOTIFY_ID:
        await query.answer("Только администратор может это делать.", show_alert=True)
        return
    await query.answer()
    db = context.bot_data["db"]
    data = query.data

    if data.startswith("db_appr_acc_"):
        target_id = int(data[len("db_appr_acc_"):])
        db.approve_access_request(target_id, "accountant", update.effective_user.id)
        await query.edit_message_text(query.message.text_markdown + "\n\n✅ Одобрено как бухгалтер.", parse_mode="Markdown")
        await context.bot.send_message(chat_id=target_id, text="✅ Доступ открыт! Вы добавлены как бухгалтер.", reply_markup=ACCOUNTANT_KEYBOARD)
    elif data.startswith("db_rej_"):
        target_id = int(data[len("db_rej_"):])
        db.reject_access_request(target_id, update.effective_user.id)
        await query.edit_message_text(query.message.text_markdown + "\n\n❌ Отклонено.", parse_mode="Markdown")
        await context.bot.send_message(chat_id=target_id, text="🔒 Ваша заявка на доступ была отклонена.")


