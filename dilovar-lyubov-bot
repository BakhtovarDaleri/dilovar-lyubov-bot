class SupabaseService:
    def __init__(self):
        self.client: Client = create_client(SUPABASE_URL, SUPABASE_KEY)
        self._category_cache = {}
        self._ip_cache = {}
        self._account_cache = {}
        self._load_caches()

    def _load_caches(self):
        cats = self.client.table("categories").select("id,name").execute().data or []
        self._category_cache = {c["name"]: c["id"] for c in cats}
        ips = self.client.table("ip").select("id,name").execute().data or []
        self._ip_cache = {i["name"]: i["id"] for i in ips}
        accs = self.client.table("accounts").select("id,code").execute().data or []
        self._account_cache = {a["code"]: a["id"] for a in accs}

    def get_category_id(self, name): return self._category_cache.get(name)
    def get_ip_id(self, name): return self._ip_cache.get(name)
    def get_account_id(self, code): return self._account_cache.get(code)

    def post_journal_entry(self, operation_id, entry_date, debit_code, credit_code, amount, comment=""):
        self.client.table("journal_entries").insert({
            "operation_id": operation_id, "entry_date": entry_date,
            "debit_account_id": self.get_account_id(debit_code),
            "credit_account_id": self.get_account_id(credit_code),
            "amount": amount, "comment": comment,
        }).execute()

    def get_suppliers_list(self, type_filter=None):
        q = self.client.table("counterparties").select("id,name,phone,type")
        if type_filter:
            q = q.eq("type", type_filter)
        return q.order("name").execute().data or []

    def get_consumables_list(self):
        res = self.client.table("consumables_catalog").select("id,name,size").order("name").execute()
        items = []
        for r in (res.data or []):
            items.append(f"{r['name']} {r['size']}" if r.get("size") else r["name"])
        return items

    def get_counterparty_by_name(self, name):
        data = self.client.table("counterparties").select("*").eq("name", name).limit(1).execute().data or []
        return data[0] if data else None

    def add_operation_returning_id(self, **fields):
        res = self.client.table("operations").insert(fields).execute()
        return res.data[0]["id"]

    def add_warehouse_movement(self, **fields):
        self.client.table("warehouse_movements").insert(fields).execute()

    def get_supplier_current_debt(self, supplier_name: str) -> float:
        cp = self.get_counterparty_by_name(supplier_name)
        if not cp:
            return 0.0
        res = self.client.table("operations").select("amount").eq("counterparty_id", cp["id"]).execute()
        return round(sum(float(r["amount"]) for r in (res.data or [])), 2)

    def get_hourly_employees(self):
        res = self.client.table("counterparties").select("id,name,hourly_rate").eq("type", "сотрудник").not_.is_("hourly_rate", "null").order("name").execute()
        return res.data or []

    def get_last_operations_for_period(self, date_from, date_to, limit=40):
        res = (
            self.client.table("operations").select("*, counterparties(name)")
            .gte("operation_date", date_from).lte("operation_date", date_to)
            .order("operation_date", desc=True).limit(limit)
            .execute()
        )
        return res.data or []

    def get_category_report_rows(self, category_id, date_from, date_to, operation_types=None):
        q = (
            self.client.table("operations")
            .select("operation_date,item_name,quantity,price,amount,comment,counterparties(name)")
            .eq("category_id", category_id)
            .gte("operation_date", date_from).lte("operation_date", date_to)
        )
        if operation_types:
            q = q.in_("operation_type", operation_types)
        res = q.order("operation_date").execute()
        return res.data or []

    def get_supplier_ledger_rows(self, counterparty_ids):
        if not counterparty_ids:
            return []
        res = (
            self.client.table("operations")
            .select("id,operation_date,operation_type,amount,counterparty_id,counterparties(name)")
            .in_("counterparty_id", counterparty_ids)
            .order("operation_date")
            .order("id")
            .execute()
        )
        return res.data or []

    def get_other_warehouse_expenses_rows(self, exclude_category_ids, date_from, date_to):
        cat_ids = [
            c["id"] for c in (self.client.table("categories").select("id").eq("group_name", "склад").execute().data or [])
            if c["id"] not in exclude_category_ids
        ]
        if not cat_ids:
            return []
        res = (
            self.client.table("operations")
            .select("operation_date,amount,comment,categories(name),counterparties(name)")
            .in_("category_id", cat_ids)
            .gte("operation_date", date_from).lte("operation_date", date_to)
            .order("operation_date")
            .execute()
        )
        return res.data or []

    # --- Доступ бухгалтера (динамическая заявка, без переменных окружения) ---
    def get_dynamic_role(self, user_id: int):
        res = self.client.table("dilovar_bot_pending_users").select("role,status").eq("user_id", user_id).eq("status", "approved").limit(1).execute()
        data = res.data or []
        return data[0]["role"] if data else None

    def get_access_request_status(self, user_id: int):
        res = self.client.table("dilovar_bot_pending_users").select("status").eq("user_id", user_id).limit(1).execute()
        data = res.data or []
        return data[0]["status"] if data else None

    def create_access_request(self, user_id: int, name: str, username: str):
        self.client.table("dilovar_bot_pending_users").insert({
            "user_id": user_id, "name": name, "username": username, "status": "pending",
        }).execute()

    def approve_access_request(self, user_id: int, role: str, decided_by: int):
        self.client.table("dilovar_bot_pending_users").update({
            "status": "approved", "role": role, "decided_at": datetime.now(TZ_MSK).isoformat(), "decided_by": decided_by,
        }).eq("user_id", user_id).execute()

    def reject_access_request(self, user_id: int, decided_by: int):
        self.client.table("dilovar_bot_pending_users").update({
            "status": "rejected", "decided_at": datetime.now(TZ_MSK).isoformat(), "decided_by": decided_by,
        }).eq("user_id", user_id).execute()


